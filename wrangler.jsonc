{
  // Tên phải TRÙNG với tên Worker đặt trên Cloudflare
  "name": "crm-tien-loi",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api"]
  },
  // Giữ các biến đã khai báo trên dashboard khi deploy lại
  "keep_vars": true,
  "observability": { "enabled": true }
}
